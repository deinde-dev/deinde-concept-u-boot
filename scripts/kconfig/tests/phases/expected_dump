
config SPL
	bool
	prompt "Enable SPL"

config TPL
	bool
	prompt "Enable TPL"

config ARCH_X
	bool
	prompt "Architecture X"

config DM
	bool
	prompt "Driver model"

config PRINTF
	bool
	prompt "printf()"

config SERIAL
	bool
	depends on DM
	prompt "Serial" if DM
	select PRINTF if DM

config GLOBAL
	bool
	prompt "Same in every phase, except for a twin"

config SPL_GLOBAL
	bool
	prompt "Twin written out by hand"

config USES_GLOBAL
	bool
	depends on GLOBAL
	prompt "Depends on an option with no phases" if GLOBAL

config PRIMARY_ONLY
	bool
	prompt "Only in the primary phase"
	default y

menu "Menu"
	depends on DM

config IN_MENU
	bool
	depends on DM
	prompt "In a menu" if DM

endmenu

config IN_IF
	bool
	depends on SERIAL
	prompt "In an if block" if SERIAL
	default y if SERIAL

config BY_ARCH
	bool
	prompt "Default set by the architecture"
	default y if ARCH_X

menu "TPL phase options"
	depends on TPL

config TPL_DM
	bool
	depends on TPL
	prompt "Driver model" if TPL

config TPL_SERIAL
	bool
	depends on TPL && TPL_DM && SERIAL
	prompt "Serial" if TPL && TPL_DM && SERIAL
	default y if TPL && TPL_DM && SERIAL

config TPL_MAX_SIZE
	hex
	depends on TPL
	prompt "Maximum size" if TPL
	default 0x1000 if TPL

config TPL_USES_GLOBAL
	bool
	depends on TPL && n
	prompt "Depends on an option with no phases" if TPL && n

menu "Menu"
	depends on TPL && TPL_DM

config TPL_IN_MENU
	bool
	depends on TPL && TPL_DM
	prompt "In a menu" if TPL && TPL_DM

endmenu

config TPL_IN_IF
	bool
	depends on TPL && TPL_SERIAL
	prompt "In an if block" if TPL && TPL_SERIAL
	default y if TPL && TPL_SERIAL

config TPL_BY_ARCH
	bool
	depends on TPL
	prompt "Default set by the architecture" if TPL
	default y if TPL && ARCH_X

endmenu

menu "SPL phase options"
	depends on SPL

config SPL_DM
	bool
	depends on SPL
	prompt "Driver model" if SPL

config SPL_PRINTF
	bool
	depends on SPL
	prompt "printf()" if SPL

config SPL_SERIAL
	bool
	depends on SPL && SPL_DM && SERIAL
	prompt "Serial" if SPL && SPL_DM && SERIAL
	select SPL_PRINTF if SPL && SPL_DM && SERIAL
	default y if SPL && SPL_DM && SERIAL

config SPL_MAX_SIZE
	hex
	depends on SPL
	prompt "Maximum size" if SPL
	default 0x1000 if SPL

config SPL_USES_GLOBAL
	bool
	depends on SPL && SPL_GLOBAL
	prompt "Depends on an option with no phases" if SPL && SPL_GLOBAL

menu "Menu"
	depends on SPL && SPL_DM

config SPL_IN_MENU
	bool
	depends on SPL && SPL_DM
	prompt "In a menu" if SPL && SPL_DM

endmenu

config SPL_IN_IF
	bool
	depends on SPL && SPL_SERIAL
	prompt "In an if block" if SPL && SPL_SERIAL
	default y if SPL && SPL_SERIAL

config SPL_BY_ARCH
	bool
	depends on SPL
	prompt "Default set by the architecture" if SPL
	default y if SPL && ARCH_X

endmenu
